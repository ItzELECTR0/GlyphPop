# Maintainer: ELECTRO
pkgname=glyphpop
pkgver=0.0.1.r0.gc65341f
pkgrel=1
pkgdesc="Emoji, kaomoji and symbol picker for Wayland that types at your text cursor"
arch=('x86_64' 'aarch64')
license=('GPL-3.0-or-later' 'Unicode-3.0' 'MIT')
# Uses QtWaylandClient private API, so rebuild after every Qt minor update.
depends=(
    'layer-shell-qt'
    'libxkbcommon'
    'qt6-base'
    'qt6-declarative'
    'qt6-wayland'
    'wayland'
)
makedepends=(
    'cmake'
    'git'
    'ninja'
    'zig>=0.17'
)
optdepends=(
    'noto-fonts-emoji: colour emoji (or any other emoji-font)'
    'xdg-desktop-portal: following the system light or dark setting and accent colour'
)

_repodir() { cd "$startdir/.." && pwd; }

prepare() {
    local _repo="$(_repodir)"
    rm -rf "$srcdir/$pkgname"
    mkdir -p "$srcdir/$pkgname"

    # Package the working tree as it is, uncommitted and untracked files included
    msg2 "Copying the working tree..."
    git -C "$_repo" ls-files -z --cached --others --exclude-standard -- . ':!packaging' |
        while IFS= read -r -d '' _file; do
            [[ -e "$_repo/$_file" ]] || continue
            install -Dm644 "$_repo/$_file" "$srcdir/$pkgname/$_file"
        done
}

pkgver() {
    "$startdir/version.sh"
}

build() {
    cmake -S "$pkgname" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

check() {
    cd "$pkgname"
    ZIG_GLOBAL_CACHE_DIR="$srcdir/build/zig-cache" zig build test --cache-dir "$srcdir/build/zig-test-cache"
}

package() {
    DESTDIR="$pkgdir" cmake --install build

    cd "$pkgname"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 data/unicode/LICENSE "$pkgdir/usr/share/licenses/$pkgname/unicode-LICENSE"
}
